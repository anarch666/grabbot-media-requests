# Media Requests Profile — Secrets
# Copy to .env and fill in real values

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram group chat ID (negative number for groups)
MEDIA_CHAT_ID=

# Seerr (Overseerr)
SEERR_API_KEY=
SEERR_URL=http://10.0.60.88:5055

# Radarr
RADARR_API_KEY=
RADARR_URL=http://10.0.60.88:7878

# Sonarr
SONARR_API_KEY=
SONARR_URL=http://10.0.60.88:8989

# SABnzbd
SABNZBD_API_KEY=
SABNZBD_URL=http://10.0.60.88:8088

# TorBox (fallback downloads)
TORBOX_API_KEY=

# Plex
PLEX_TOKEN=
PLEX_URL=http://10.0.60.88:32400

# Allow any Telegram group member to interact
GATEWAY_ALLOW_ALL_USERS=true

# LLM Provider key (LiteLLM proxy)
LITELLM_MASTER_KEY=
